# Copy to .env.local and fill in. NEVER commit real values.
# Every service below is one you create yourself — see README "Setup".

# --- Core -------------------------------------------------------------------
# Public origin, no trailing slash. http://localhost:3000 in development.
APP_URL="http://localhost:3000"
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Database (Neon / Supabase / any Postgres) ------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Email (Resend) ---------------------------------------------------------
# Without this the app prints emails to the server console instead of sending.
RESEND_API_KEY=""
# Must be on a domain you have verified in Resend, with SPF/DKIM/DMARC set up.
EMAIL_FROM="invoices@mail.yourdomain.com"
# From the Resend webhook settings, for delivery/bounce events.
RESEND_WEBHOOK_SECRET=""

# --- Stripe -----------------------------------------------------------------
# One platform account. Connect must be enabled separately in the dashboard
# (Settings -> Connect), including the platform profile questionnaire.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Endpoint 1 — OUR billing. Events from our own account.
#   Listen for: checkout.session.completed, customer.subscription.updated,
#               customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""

# Endpoint 2 — CONNECT. Events from connected accounts ("Listen to events on
# Connected accounts" must be ticked when creating this endpoint).
#   Listen for: checkout.session.completed, charge.refunded, account.updated
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Price IDs for our own subscription, created under Stripe -> Products.
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_ANNUAL=""

# --- Cron -------------------------------------------------------------------
# Shared secret so only Vercel Cron can trigger the reminder sweep.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- Optional ---------------------------------------------------------------
# Rate limiting. Without these, limits fall back to in-memory (per-instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
